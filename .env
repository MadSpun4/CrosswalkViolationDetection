# Video source: container path or RTSP URL
VIDEO_SOURCE=/app/input_data/test.mp4

# Optional: ROI for traffic light (x1,y1,x2,y2) in pixels
# If empty, can be set via Web UI
TRAFFIC_LIGHT_ROI=

# Optional: crosswalk polygon (x1,y1;x2,y2;x3,y3;...)
# If empty, can be set via Web UI (4 points)
CROSSWALK_POLYGON=

# Preprocessing toggles
ENABLE_HOMOMORPHIC=1
ENABLE_HIST_EQ=0
ENABLE_GAUSSIAN_BLUR=0
GAUSSIAN_KERNEL=5

# Pedestrian detector
YOLO_MODEL=yolov8n.pt
YOLO_CONF=0.35

# Alerting
ALERT_MODE=console
ALERT_COOLDOWN_SEC=2.0

# Runtime calibration storage (NOT video/data storage; only UI-selected coordinates)
RUNTIME_CONFIG=/app/runtime/calibration.json

# Performance knobs
# Process every N-th frame (1 = every frame; 4 = process each 4th frame)
PROCESS_STRIDE=3
# Limit UI streaming FPS (0 = unlimited). Useful when CPU-bound on JPEG streaming.
OUTPUT_MAX_FPS=0
# JPEG quality for stream (30..95)
JPEG_QUALITY=80

# Traffic light brightness threshold (mean grayscale in ROI)
TL_BRIGHTNESS_T=60

# Optional: downscale MJPEG stream to increase UI FPS (0 = no resize)
STREAM_MAX_WIDTH=0
STREAM_MAX_HEIGHT=0

# === Performance / real-time knobs (v5) ===
# Pedestrian detector throttle (does NOT throttle UI; pipeline runs every frame)
# 1 = detect each frame; 4 = detect each 4th frame (reuses last bbox between detections)
PED_DETECT_STRIDE=3
# How long to keep last detection if detector is skipped (frames). 0 disables holding.
PED_HOLD_FRAMES=12

# Traffic light detection: brightness + red-color gate (to avoid false positives)
TL_BRIGHTNESS_T=60
TL_RED_FRACTION_T=0.010
TL_HSV_S_T=90
TL_HSV_V_T=90
