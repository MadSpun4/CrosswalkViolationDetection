# Источник видео
VIDEO_SOURCE=/app/input_data/test.mp4

# ROI светофора: x1,y1,x2,y2
# Задаётся через UI
TRAFFIC_LIGHT_ROI=

# Полигон перехода: x1,y1;x2,y2;...
# Задаётся через UI
CROSSWALK_POLYGON=

# Предобработка
ENABLE_HOMOMORPHIC=0
ENABLE_HIST_EQ=0
ENABLE_GAUSSIAN_BLUR=0
GAUSSIAN_KERNEL=1

# Детектор пешеходов
YOLO_MODEL=yolov8n.pt
YOLO_CONF=0.35
# Класс person в датасете COCO – 0
YOLO_PERSON_CLASS=0
# Размер пакета для пакетной проверки ROI-кандидатов моделью YOLO.
YOLO_BATCH_SIZE=16
# Объединение пересекающихся/близких ROI перед YOLO.
YOLO_ROI_MERGE_IOU=0.10
YOLO_ROI_MERGE_GAP=24
# Максимальное число ROI, передаваемых в YOLO на одном кадре.
# 1 = объединять все ROI Виолы-Джонса в одну общую область.
YOLO_MAX_ROIS_PER_FRAME=1

# ROI-кандидаты Viola-Jones
# Пусто – каскад OpenCV по умолчанию
VIOLA_CASCADE_PATH=
VIOLA_SCALE_FACTOR=1.1
VIOLA_MIN_NEIGHBORS=3
VIOLA_MIN_WIDTH=24
VIOLA_MIN_HEIGHT=48
VIOLA_PADDING=0.35

# Разметка и настройки UI
RUNTIME_CONFIG=/app/runtime/calibration.json

# Производительность
# Анализ каждого N-го кадра.
PROCESS_STRIDE=2
# 1 – показывать кадр после предобработки.
DISPLAY_PREPROCESSED=1
# Лимит FPS потока UI, 0 – без лимита.
OUTPUT_MAX_FPS=0
# Качество JPEG потока, 30..95.
JPEG_QUALITY=80

# Порог яркости светофора.
TL_BRIGHTNESS_T=60
# Режим color – HSV; brightness – яркость.
TL_DETECTION_MODE=color
TL_COLOR_FRACTION_T=0.003
TL_COLOR_MARGIN=1.25
TL_COLOR_MIN_S=70
TL_COLOR_MIN_V=80
# 1 – зелёный считается запретом.
TRAFFIC_LIGHT_INVERTED=0

# Уменьшение MJPEG, 0 – без изменения.
STREAM_MAX_WIDTH=0
STREAM_MAX_HEIGHT=0

# Формула режима brightness:
# Y = 0.299R + 0.587G + 0.114B.
